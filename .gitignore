# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files: secrets never go in git (an example file may be committed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The project installs with npm (package-lock.json). A committed pnpm lockfile
# would make Vercel switch package managers, so local pnpm files stay out.
pnpm-lock.yaml
pnpm-workspace.yaml

# local tooling and editor state
.gstack/
.claude/worktrees/
.claude/launch.json
.claude/settings.local.json
.obsidian/
/memory/

# lint reports
/eslint-*.json

# graft's local graph cache, regenerable, not committed (run `graft build`).
/graft/
